DATABASE_URL="postgresql://pascack:pascack@localhost:5433/pascack_planner"

# Auth.js
AUTH_SECRET=""            # openssl rand -base64 32
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional build-time release ID. Docker generates one if omitted.
# Reuse it across replicas of the same release; change it for each release.
NEXT_DEPLOYMENT_ID=""

# Bootstrap admins, comma separated, applied on first sign-in
ADMIN_EMAILS=""
# DOMAIN_ALLOWLIST | OPEN | INVITE_ONLY
SIGNUP_MODE_DEFAULT="DOMAIN_ALLOWLIST"

# Email (Resend), send from a domain you control
RESEND_API_KEY=""
EMAIL_FROM=""

# Web push, generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"  # a contact address for push services
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Cron routes (sent as a header by Dokploy Schedules)
CRON_SECRET=""

# Dev only (never in production): enables /api/dev-login
DEV_AUTH=false
